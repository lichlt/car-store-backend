# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://carstore:carstore@localhost:5432/carstore_backend

# Redis
REDIS_URL=redis://localhost:6379
MOL_TOKEN_ENCRYPTION_SECRET=change-me-at-least-32-characters-secret
MOL_TOKEN_DURATION_SECONDS=600

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Session OTP
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5

# Cookie
COOKIE_DOMAIN=localhost

# Frontend
FRONTEND_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@carstore.com

# Logging
LOG_LEVEL=info

# Seed admin (used by admin.seed.ts)
SEED_ADMIN_EMAIL=admin@carstore.com
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_ADMIN_FULL_NAME=Super Admin

